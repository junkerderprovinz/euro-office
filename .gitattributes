# Shell scripts + the init banner run on Linux (Ubuntu) - always store and
# check out LF so a Windows CRLF checkout can never break the shebang or the
# log-banner rendering.
*.sh text eol=lf
chown-heal.sh text eol=lf
print-banner.sh text eol=lf
chown-heal.conf text eol=lf
.github/assets/banner-raw.txt text eol=lf
